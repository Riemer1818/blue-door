# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and we do opt in for the example. It carries no secrets, only the variable
# names and the reasoning behind them, and an example nobody can clone is not
# one. The real .env.local stays ignored by the line above.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local blob store and run staging. Both are content the app writes at runtime,
# not source; BLOB_DIR and RUN_STAGING_DIR move them in a deployment.
.blobs/
.runs/
