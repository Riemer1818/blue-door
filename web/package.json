{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose -f ../docker-compose.local.yml up -d --wait",
    "db:migrate": "../db/apply.sh",
    "db:seed": "../db/seed-dev.sh",
    "db:types": "kysely-codegen --url \"$DATABASE_URL_ADMIN\" --dialect postgres --camel-case --out-file src/lib/db-types.ts",
    "typecheck": "node scripts/generate-outcomes.mjs && next typegen && tsc --noEmit",
    "outcomes:types": "node scripts/generate-outcomes.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.0",
    "@blocknote/mantine": "^0.54.0",
    "@blocknote/react": "^0.54.0",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "ajv": "^8.20.0",
    "kysely": "^0.29.5",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-arborist": "^3.16.0",
    "react-dom": "19.2.8",
    "react-grid-layout": "^2.2.4",
    "superjson": "^2.2.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "kysely-codegen": "^0.20.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.14.0"
}
