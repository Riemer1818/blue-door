# Local development. Copy to .env.local (gitignored).
#
# Note the role: bluedoor_app, not postgres. Developing against the owner role
# would silently bypass every row-level security policy, and the first time you
# noticed would be in production.
DATABASE_URL="postgres://bluedoor_app:bluedoor_app@127.0.0.1:5433/bluedoor"

# Stands in for a session until real auth lands. Matches db/seed-dev.sh.
# Setting this in a deployed environment is a hard error — see src/server/session.ts.
DEV_USER_ID="00000000-0000-4000-8000-000000000d01"

# The adapter agent (BLU-6). Leave UNSET for local development: the Claude Agent
# SDK falls back to whatever credentials Claude Code already holds, so a Pro/Max
# subscription works with no key and no marginal cost.
#
# Set it only when the agent runs as a service on behalf of other users - a
# subscription is bound to one account and metered per-user, so it cannot back a
# multi-tenant backend. In production this comes from a Scaleway secret, never
# from a file.
#
# The process holding this key builds untrusted Dockerfiles. It must hold NOTHING
# ELSE - no DATABASE_URL, no Scaleway credentials, no Linear token.
# ANTHROPIC_API_KEY=""

# Wrap reports the promotion gate reads: one <run_id>/report.json per run.
# Defaults to ../tools/.runs, which is where wrap.py writes. Point it at
# web/fixtures/wrap-runs to develop the gate without running the agent.
WRAP_RUNS_DIR="../tools/.runs"
